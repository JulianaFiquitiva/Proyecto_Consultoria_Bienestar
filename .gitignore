# Datos (sensibles, no subir)
*.xlsx
*.csv
*.xls

# ...pero los entregables de la actividad SI se versionan
!resultados/*.csv
# hojas de revision ciega exportadas a Excel (tests/hoja_a_xlsx.py)
!resultados/*.xlsx
# indice RAG (~100 MB): se versiona para que la app publicada responda con
# el corpus. Se regenera con  python -m agent.rag.index --rebuild
!rag_store/calibracion.csv
!agent/rag/logs/*.csv

# Archivos temporales de LaTeX
*.aux
*.log
*.out
*.toc
*.nav
*.snm

# Archivos binarios
*.deb
*.pyc
__pycache__/

# Entorno virtual
venv/
env/

# IDE
.vscode/
.idea/

# pytest
.pytest_cache/

# Archivos grandes innecesarios
IndiceFelicidad/

# Corpus de articulos (los PDF no se suben; su indice en rag_store/ si)
docs/rag_corpus/*.pdf

# Datos de la contraparte y claves
data/*.xlsx
.env
*.env

